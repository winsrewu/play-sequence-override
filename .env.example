# ---------------------------------------------------------------------------
# jawbts embedding service
# ---------------------------------------------------------------------------
# Public JWKS of the jawbts-api deployment that signs the bearer tokens.
# Local tests may use http:// only with ALLOW_INSECURE_JWKS=true.
JWKS_URL=https://api.jawbts.org/.well-known/jwks.json
JWT_ISSUER=jawbts-api
# The delegated token minted by jawbts-gateway carries this scope.
REQUIRED_SCOPE=play_sequence_override

# For local development with a throwaway JWKS server:
# JWKS_URL=http://127.0.0.1:9000/.well-known/jwks.json
# ALLOW_INSECURE_JWKS=true

# Read-only playlist used for optional internal-id membership checks.
CATALOG_PATH=/app/data/music.v2.json
# false: accept any well-formed Bilibili internal id (recommended for custom
# playlists). true: reject ids that are not in CATALOG_PATH.
CATALOG_STRICT=false

MODEL_PATH=/app/assets/mn10_as_mAP_471.pt
EFFICIENTAT_PATH=/app/vendor/EfficientAT
# Decode/embedding window. Also the byte-range target for long tracks.
# 900 keeps vectors comparable with the precomputed embed_data.
MAX_DURATION_SECONDS=900
MAX_AUDIO_BYTES=134217728
# FireRedVAD AED (bundled in the image) detects vocals in each track; a track
# counts as having lyrics when the singing-or-speech ratio reaches this threshold.
VOCALS_MODEL_PATH=/app/assets/fireredvad/AED
VOCALS_MIN_RATIO=0.5
# Per-frame singing confidence and the shortest event (10 ms frames).
VOCALS_SINGING_THRESHOLD=0.5
VOCALS_MIN_EVENT_FRAMES=20
# Detection-only workers (download + decode + FireRedVAD, no embedding).
VOCALS_WORKERS=4
VOCALS_MAX_PENDING=256
# In-container vector cache: id -> vector. TTL in seconds; 0 disables the cache.
VECTOR_CACHE_TTL_SECONDS=86400
VECTOR_CACHE_MAX_ENTRIES=4096
# Background workers for POST /v1/embeddings (fetch + decode + embed).
EMBED_WORKERS=2
EMBED_MAX_PENDING=256
EMBED_FAILURE_BACKOFF_SECONDS=60
# Unavailable videos are not retried for this long (seconds).
EMBED_UNAVAILABLE_TTL_SECONDS=86400
TORCH_THREADS=4
# Set true only if the Bilibili requests must go through HTTP(S)_PROXY.
TRUST_ENV_PROXY=false
LOG_LEVEL=info

# LOCAL DEVELOPMENT ONLY: bypass bearer/JWKS auth. The service binds to
# 127.0.0.1 in docker-compose; never expose DEV_MODE on a public interface.
# Prefer `docker compose -f docker-compose.yml -f docker-compose.dev.yml up`.
DEV_MODE=false

# Optional CORS. The Edge extension calls from its service worker, which uses
# host permissions, so this is normally empty.
# CORS_ALLOW_ORIGINS=https://www.bilibili.com
